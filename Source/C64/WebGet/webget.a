; SPDX-License-Identifier: MIT
;
; WebGet client: the C64 half of the web downloader host
; (Source/Teensy/TlsHost). The host draws every screen; this cartridge paints
; the rows it is sent and hands it the keys that are typed.
;
; It speaks the same IO2 link as the stock extension host's clients
; (vm/abi/README.md section 6), opened by selecting EasyFlash bank 58:
;
;   $DF00..$DFEF  published packet: "M3" 01 type seq flags len 00 <payload> crc16
;   $DFF4         command    1 start, 3 input ready
;   $DFF5         status     2 running, $E0 failed
;   $DFF6         acknowledge: write back the sequence you consumed
;   $DFF7         sequence of the packet currently published, 0 for none
;   $DFF8..$DFFA  input: key, 0, 0
;   $DFFB         failure code when status is $E0
;   $DFFC         token of the last input record the host took
;   $DFFD..$DFFF  input: protocol, token, checksum
;
; Packet type 1 paints a row: payload[0] screen row, payload[1] colour,
; payload[2..41] 40 screen codes. Input protocol $82 carries one PETSCII key in
; the first byte. A key is sent only once $DFFC shows the host took the last
; one, so keys typed while the host is busy wait in the KERNAL's buffer rather
; than overwrite each other.

HOSTBANK   = 58
IO2        = $DF00
CMD        = $DFF4
STATUS     = $DFF5
ACK        = $DFF6
SEQ        = $DFF7
FAILCODE   = $DFFB
TAKEN      = $DFFC

SCREEN     = $0400
COLOUR     = $D800
GETIN      = $FFE4

; Free RAM once the cartridge cold start has run.
packetbuf  = $C000        ; 238 bytes
total      = $C100
crcn       = $C101
crclo      = $C102
crchi      = $C103
lastseq    = $C104
pending    = $C105        ; a key waiting for the host, 0 for none
token      = $C106
ptr        = $FB
cptr       = $FD

; ---------------------------------------------------------------- ROML $8000
* = $8000
        !word coldstart
        !word coldstart
        !byte $C3, $C2, $CD, $38, $30    ; CBM80

coldstart:
        sei
        ; The KERNAL jumps straight here on finding the cartridge, before it has
        ; initialised anything, so the cartridge does it.
        jsr $FDA3                ; IOINIT
        jsr $FD50                ; RAMTAS
        jsr $FD15                ; RESTOR
        jsr $FF5B                ; CINT
        cli
        lda #$17                 ; lower/upper case set: URLs are mostly lower case
        sta $D018
        lda #$80                 ; and SHIFT+C= may not switch it back
        sta $0291
        jsr $E544                ; clear screen
        lda #0
        sta $D020
        sta $D021
        sta lastseq
        sta pending

        ; Open the host window, then ask the host to start. RESTORE lands here
        ; too, through the KERNAL's NMI handler finding CBM80, with the host
        ; still running: the token then starts from the last one it took, or
        ; no key would get through again, and the start tells it to repaint.
        lda #HOSTBANK
        sta $DE00
        lda TAKEN
        sta token
        lda #1
        sta CMD

main:
        lda STATUS
        cmp #$E0
        bne running
        jmp failed
running:
        lda SEQ
        beq noPacket             ; nothing published yet
        cmp lastseq
        beq noPacket             ; already consumed this one
        jsr readPacket
        bcc noPacket             ; bad frame: leave it, the host will hold it
        lda packetbuf + 4        ; the sequence the packet itself carries
        sta lastseq
        sta ACK
noPacket:
        jsr pollKeys
        jmp main

; ---- Copy, validate and apply the published packet ------------------------
; Returns carry set when the packet was consumed, clear when it was not.
badFrame:
        clc
        rts

readPacket:
        lda IO2 + 0
        cmp #$4D                 ; 'M'
        bne badFrame
        lda IO2 + 1
        cmp #$33                 ; '3'
        bne badFrame
        lda IO2 + 2
        cmp #1                   ; framing version
        bne badFrame
        lda IO2 + 6              ; payload length
        cmp #229
        bcs badFrame
        clc
        adc #8
        sta crcn                 ; bytes covered by the CRC
        clc
        adc #2
        sta total                ; bytes to copy, including the CRC itself

        ; Take a copy before checking it: the window is live, and validating
        ; bytes that can change underneath us proves nothing.
        ldy #0
copyLoop:
        lda IO2, y
        sta packetbuf, y
        iny
        cpy total
        bne copyLoop

        lda #$FF
        sta crclo
        sta crchi
        ldy #0
crcLoop:
        lda packetbuf, y
        jsr updateCrc
        iny
        cpy crcn
        bne crcLoop
        ldy crcn
        lda packetbuf, y
        cmp crclo
        bne badFrame
        iny
        lda packetbuf, y
        cmp crchi
        bne badFrame

        ; Valid. Unknown types are acknowledged and ignored.
        lda packetbuf + 3
        cmp #1
        bne consumed
        lda packetbuf + 6
        cmp #42                  ; a row packet carries 42 bytes
        bne consumed
        ldx packetbuf + 8        ; payload[0]: screen row
        cpx #25
        bcs consumed
        lda rowLo, x
        sta ptr
        sta cptr
        lda rowHi, x
        sta ptr + 1
        lda colourHi, x
        sta cptr + 1
        ldy #0
paintLoop:
        lda packetbuf + 10, y    ; payload[2 + y]
        sta (ptr), y
        lda packetbuf + 9        ; payload[1]: colour
        sta (cptr), y
        iny
        cpy #40
        bne paintLoop
consumed:
        sec
        rts

; CRC16-CCITT, MSB first, polynomial $1021 -- the same one the host computes.
updateCrc:
        eor crchi
        sta crchi
        ldx #8
crcBit:
        asl crclo
        rol crchi
        bcc crcNext
        lda crchi
        eor #$10
        sta crchi
        lda crclo
        eor #$21
        sta crclo
crcNext:
        dex
        bne crcBit
        rts

; ---- Keys -----------------------------------------------------------------
pollKeys:
        lda TAKEN
        cmp token
        beq linkFree
        lda #3                   ; the host has not taken the last key: offer it again
        sta CMD
        rts
linkFree:
        jsr GETIN
        beq keysDone
        sta pending

        ; Build the whole record before raising the command: the host ignores
        ; one whose token repeats or whose checksum does not match.
        lda pending
        sta $DFF8                ; key
        lda #0
        sta $DFF9
        sta $DFFA
        lda #$82
        sta $DFFD                ; protocol: one PETSCII key
        inc token
        bne tokenOk
        inc token                ; zero means "no input", so skip it
tokenOk:
        lda token
        sta $DFFE
        lda #$A5
        eor pending
        eor #$82
        eor token
        sta $DFFF                ; checksum
        lda #3
        sta CMD
        lda #0
        sta pending
keysDone:
        rts

; ---- Failure --------------------------------------------------------------
failed:
        ldx #0
messageLoop:
        lda failMessage, x
        beq showCode
        sta SCREEN + 24 * 40, x
        lda #2                   ; red
        sta COLOUR + 24 * 40, x
        inx
        bne messageLoop
showCode:
        lda FAILCODE
        pha
        lsr
        lsr
        lsr
        lsr
        jsr nybble
        sta SCREEN + 24 * 40 + 13
        pla
        and #$0F
        jsr nybble
        sta SCREEN + 24 * 40 + 14
        lda #2
        sta COLOUR + 24 * 40 + 13
        sta COLOUR + 24 * 40 + 14
stop:
        jmp stop

; A nybble as a screen code in the lower/upper case set: 0-9, then a-f.
nybble:
        cmp #10
        bcc digit
        sbc #9                   ; carry is set: 10 -> 1, screen code 'a'
        rts
digit:
        ora #$30
        rts

failMessage:
        !scr "host failed "
        !byte 0

rowLo:
        !for row, 0, 24 { !byte <(SCREEN + row * 40) }
rowHi:
        !for row, 0, 24 { !byte >(SCREEN + row * 40) }
colourHi:
        !for row, 0, 24 { !byte >(COLOUR + row * 40) }

        !fill $A000 - *, $FF

; ---------------------------------------------------------------- ROMH $E000
; The firmware starts the cartridge in Ultimax, where this bank answers at
; $E000 and holds the reset vector. It has to switch to 16 KiB mode and hand
; back to the KERNAL, which then finds the CBM80 header above. The switch is
; made from RAM: the moment $DE02 latches, ROMH leaves $E000 and the KERNAL
; appears in its place (see Source/C64/VMHello/vmhello.a).
!pseudopc $E000 {
        !fill $FF00 - $E000, $FF
ultimax:
        sei
        ldx #$FF
        txs
        cld
        ldx #7
copyStub:
        lda stub, x
        sta $0100, x             ; below the stack, which starts at $01FF
        dex
        bpl copyStub
        jmp $0100
stub:
        !byte $A9, $87           ; lda #$87   LED on, 16 KiB mode: GAME and EXROM asserted
        !byte $8D, $02, $DE      ; sta $DE02
        !byte $4C, $E2, $FC      ; jmp $FCE2  KERNAL reset, which finds the cartridge
        !fill $FFFA - *, $FF
        !word ultimax            ; NMI
        !word ultimax            ; RESET
        !word ultimax            ; IRQ
}
